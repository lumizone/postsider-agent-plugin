{
  "mcpServers": {
    "postsider": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://mcp.postsider.com/mcp",
        "--transport",
        "http-only",
        "--auth-timeout",
        "300",
        "--static-oauth-client-metadata",
        "{\"client_name\":\"PostSider plugin\",\"token_endpoint_auth_method\":\"none\",\"grant_types\":[\"authorization_code\",\"refresh_token\"],\"response_types\":[\"code\"]}"
      ]
    }
  }
}
