  "license": "MIT",
  "keywords": ["social-media", "scheduling", "publishing", "content-calendar", "approvals", "analytics", "automation", "mcp"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "postsider": {
          "trust": "untrusted"
        }
